# Sanity project (from sanity.io/manage) — project-level, safe to share within team
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Sanity Context requires an ORGANIZATION-level API token with "Context Viewer"
# permission. A project-level token will NOT work here — create it under your
# organization settings, not your project settings.
SANITY_ORG_ID=
SANITY_CONTEXT_TOKEN=

# Get from aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Required by web/lib/sanity-client.ts (the custom GROQ tools). A project-level
# token, unlike SANITY_CONTEXT_TOKEN above — the org-level Context token
# cannot perform plain GROQ reads (401 "project user not found"). Without
# this, every /api/chat request fails. Currently reuses SANITY_WRITE_TOKEN's
# value below rather than a dedicated read-only token — see README.
SANITY_READ_TOKEN=

# Required by scripts/write-seed-data.ts only (project-level, Editor/Admin
# permission — used to write seed organization/grant documents into Sanity).
# Not needed by the deployed web/ app itself.
SANITY_WRITE_TOKEN=
